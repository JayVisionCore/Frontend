<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday! 🎂</title>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
  <div class="hearts-container" id="hearts"></div>
  <div class="confetti-container" id="confetti"></div>

  <section class="hero">
    <h1 class="title">Happy Birthday!</h1>
    <h2 class="name">JANHAVI 💛</h2>
    <div class="photo-frame">
      <img src="https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=400&h=500&fit=crop" alt="Birthday Girl">
    </div>
    <p class="subtitle">Wishing you the most magical day! ✨</p>
  </section>

  <section class="gallery">
    <h2 class="section-title">Beautiful Memories 💕</h2>
    <div class="photo-grid">
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&h=300&fit=crop" alt="Photo 1"><span>So Pretty! 💕</span></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&h=300&fit=crop" alt="Photo 2"><span>Beautiful Smile ✨</span></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&h=300&fit=crop" alt="Photo 3"><span>My Favorite 💖</span></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=300&h=300&fit=crop" alt="Photo 4"><span>Always Shining 🌟</span></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?w=300&h=300&fit=crop" alt="Photo 5"><span>Fun Times! 🎉</span></div>
      <div class="gallery-item"><img src="https://images.unsplash.com/photo-1502823403499-6ccfcf4fb453?w=300&h=300&fit=crop" alt="Photo 6"><span>Best Memories 💝</span></div>
    </div>
  </section>

  <section class="message">
    <div class="message-card">
      <h2>A Special Message For You 💌</h2>
      <p>On this special day, I want you to know how much you mean to me. You're not just my best friend – you're my sister, my confidant, and my partner in all our crazy adventures!</p>
      <p>Your smile lights up every room, your kindness touches everyone you meet, and your strength inspires me every single day.</p>
      <p>May this year bring you endless joy, incredible adventures, and all the love your beautiful heart deserves!</p>
      <p class="signature">With all my love,<br><span>Your Best Friend</span></p>
    </div>
  </section>

  <footer>Made with 💖 just for you!</footer>
</body>
</html>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Quicksand', sans-serif;
  background: linear-gradient(135deg, #fff5f5 0%, #fdf2f8 50%, #faf5ff 100%);
  min-height: 100vh;
  overflow-x: hidden;
}

/* Floating Hearts */
.hearts-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.heart {
  position: absolute;
  font-size: 20px;
  animation: floatUp 8s ease-in infinite;
  opacity: 0.7;
}

@keyframes floatUp {
  0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
  10% { opacity: 0.7; }
  90% { opacity: 0.7; }
  100% { transform: translateY(-100px) rotate(360deg); opacity: 0; }
}

/* Confetti */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.confetti {
  position: absolute;
  width: 10px;
  height: 10px;
  animation: confettiFall 5s ease-in-out infinite;
}

@keyframes confettiFall {
  0% { transform: translateY(-100px) rotate(0deg); opacity: 1; }
  100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
}

/* Hero Section */
.hero {
  text-align: center;
  padding: 60px 20px;
  position: relative;
  z-index: 10;
}

.title {
  font-family: 'Dancing Script', cursive;
  font-size: 4rem;
  color: #ec4899;
  text-shadow: 2px 2px 4px rgba(236, 72, 153, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.name {
  font-family: 'Dancing Script', cursive;
  font-size: 2.5rem;
  color: #a855f7;
  margin: 10px 0 30px;
}

.photo-frame {
  display: inline-block;
  background: white;
  padding: 15px 15px 40px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.15);
  transform: rotate(-3deg);
  transition: transform 0.3s ease;
  animation: float 6s ease-in-out infinite;
}

.photo-frame:hover {
  transform: rotate(0deg) scale(1.05);
}

@keyframes float {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50% { transform: translateY(-15px) rotate(3deg); }
}

.photo-frame img {
  width: 280px;
  height: 350px;
  object-fit: cover;
  border-radius: 5px;
}

.subtitle {
  margin-top: 30px;
  font-size: 1.3rem;
  color: #6b7280;
}

/* Gallery Section */
.gallery {
  padding: 60px 20px;
  position: relative;
  z-index: 10;
}

.section-title {
  font-family: 'Dancing Script', cursive;
  font-size: 2.5rem;
  color: #ec4899;
  text-align: center;
  margin-bottom: 40px;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 25px;
  max-width: 900px;
  margin: 0 auto;
}

.gallery-item {
  background: white;
  padding: 10px;
  border-radius: 15px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.1);
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.gallery-item:hover {
  transform: translateY(-10px) rotate(2deg);
  box-shadow: 0 15px 40px rgba(236, 72, 153, 0.3);
}

.gallery-item img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 10px;
}

.gallery-item span {
  display: block;
  margin-top: 10px;
  color: #a855f7;
  font-weight: 600;
}

/* Message Section */
.message {
  padding: 60px 20px;
  position: relative;
  z-index: 10;
}

.message-card {
  max-width: 600px;
  margin: 0 auto;
  background: linear-gradient(135deg, #ffffff 0%, #fdf2f8 100%);
  padding: 40px;
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(236, 72, 153, 0.2);
  border: 2px solid #fce7f3;
}

.message-card h2 {
  font-family: 'Dancing Script', cursive;
  font-size: 2rem;
  color: #ec4899;
  margin-bottom: 25px;
  text-align: center;
}

.message-card p {
  color: #4b5563;
  line-height: 1.8;
  margin-bottom: 15px;
  font-size: 1.1rem;
}

.signature {
  text-align: right;
  font-style: italic;
  color: #9ca3af;
  margin-top: 30px;
}

.signature span {
  font-family: 'Dancing Script', cursive;
  font-size: 1.5rem;
  color: #a855f7;
}

/* Footer */
footer {
  text-align: center;
  padding: 30px;
  color: #9ca3af;
  font-size: 1rem;
  position: relative;
  z-index: 10;
}

/* Responsive */
@media (max-width: 600px) {
  .title { font-size: 2.5rem; }
  .name { font-size: 1.8rem; }
  .photo-frame img { width: 220px; height: 280px; }
}
// Create floating hearts
function createHearts() {
  const container = document.getElementById('hearts');
  const hearts = ['💕', '💖', '💗', '💝', '❤️', '💜', '🩷'];
  
  setInterval(() => {
    const heart = document.createElement('div');
    heart.className = 'heart';
    heart.textContent = hearts[Math.floor(Math.random() * hearts.length)];
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.animationDuration = (Math.random() * 4 + 6) + 's';
    heart.style.fontSize = (Math.random() * 15 + 15) + 'px';
    container.appendChild(heart);
    
    setTimeout(() => heart.remove(), 10000);
  }, 500);
}

// Create confetti
function createConfetti() {
  const container = document.getElementById('confetti');
  const colors = ['#ec4899', '#a855f7', '#f472b6', '#c084fc', '#fbbf24', '#34d399'];
  
  setInterval(() => {
    const confetti = document.createElement('div');
    confetti.className = 'confetti';
    confetti.style.left = Math.random() * 100 + 'vw';
    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
    confetti.style.animationDuration = (Math.random() * 3 + 3) + 's';
    confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
    container.appendChild(confetti);
    
    setTimeout(() => confetti.remove(), 6000);
  }, 300);
}

// Start animations
createHearts();
createConfetti();
